@startuml

' Abstract class Document
abstract class Document {
    - {static} compteur: int
    - {final} id: int
    - {final} titre: String
    - {final} annee: int
    + {abstract} descriptionCourte(): String
    + getTitre(): String
    + getId(): int
    + compareTo(Document autre): int
}

' Interface Empruntable
interface Empruntable {
    + emprunter(): void throws DocumentIndisponibleException
    + rendre(): void
    + estDisponible(): boolean
}

' Interface AutoCloseable
interface AutoCloseable {
    + close(): void
}

' Report generation interfaces
interface FormatRapport {
    + formatter(List<Document>): String
}

interface Notificateur {
    + notifier(String message): void
}

interface DestinationRapport {
    + ecrire(String contenu): void
}

' Concrete classes
class Livre {
    - auteur: String
    - nbPages: int
    - disponible: boolean
    + descriptionCourte(): String
    + emprunter(): void
    + rendre(): void
    + estDisponible(): boolean
}

class Dvd {
    - dureeMin: int
    - disponible: boolean
    + descriptionCourte(): String
    + emprunter(): void
    + rendre(): void
    + estDisponible(): boolean
}

class Revue {
    - numero: int
    + descriptionCourte(): String
}

' Generic class Catalogue
class Catalogue<T extends Document> {
    - elements: List<T>
    + ajouter(T element): void
    + rechercherParTitre(String titre): Optional<T>
    + afficherTout(): void
    + {static} max(List<T> liste): T
}

' Exception hierarchy
abstract class MediathequeException {
    + MediathequeException(String message)
    + MediathequeException(String message, Throwable cause)
}

class DocumentIndisponibleException {
    + DocumentIndisponibleException(String message)
    + DocumentIndisponibleException(String message, Throwable cause)
}

class DocumentIntrouvableException {
    + DocumentIntrouvableException(String message)
    + DocumentIntrouvableException(String message, Throwable cause)
}

' Composition classes
class Bibliothecaire {
    - catalogue: Catalogue<Document>
    - nom: String
    + Bibliothecaire(String nom, Catalogue<Document> catalogue)
    + accueillir(): void
    + ajouterDocument(Document d): void
    + afficherCatalogue(): void
}

class EmpruntManager {
    - catalogue: Catalogue<Document>
    + EmpruntManager(Catalogue<Document> catalogue)
    + emprunter(String titre): void
}

class RapportEmprunts {
    - nbEmprunts: int
    + enregistrer(): void
    + close(): void
}

' Report generation classes
class RapportService {
    - format: FormatRapport
    - destination: DestinationRapport
    - notificateur: Notificateur
    + RapportService(FormatRapport, DestinationRapport, Notificateur)
    + genererRapport(List<Document>): void throws IOException
}

class FormatCsv implements FormatRapport {
    + formatter(List<Document>): String
}

class FormatTxt implements FormatRapport {
    + formatter(List<Document>): String
}

class FormatJson implements FormatRapport {
    + formatter(List<Document>): String
}

class NotificateurEmail implements Notificateur {
    - serveur: ServeurSmtp
    + NotificateurEmail(ServeurSmtp)
    + notifier(String message): void
}

class EcrivainDisque implements DestinationRapport {
    - chemin: String
    + EcrivainDisque(String chemin)
    + ecrire(String contenu): void throws IOException
}

class ServeurSmtp {
    - serveur: String
    + ServeurSmtp(String serveur)
    + envoyer(String destinataire, String sujet): void
}

' Inheritance relationships
Document <|-- Livre
Document <|-- Dvd
Document <|-- Revue

' Interface implementation
Empruntable <|.. Livre
Empruntable <|.. Dvd

' Dependency
Catalogue ..> Document : uses

' Exception hierarchy
MediathequeException <|-- DocumentIndisponibleException
MediathequeException <|-- DocumentIntrouvableException

' Composition relationships
Bibliothecaire *-- Catalogue : composition
EmpruntManager *-- Catalogue : composition

' AutoCloseable
RapportEmprunts ..|> AutoCloseable

' Report generation interface implementations
FormatRapport <|.. FormatCsv
FormatRapport <|.. FormatTxt
FormatRapport <|.. FormatJson
Notificateur <|.. NotificateurEmail
DestinationRapport <|.. EcrivainDisque

' Report generation dependencies
RapportService ..> FormatRapport : uses
RapportService ..> Notificateur : uses
RapportService ..> DestinationRapport : uses
NotificateurEmail --> ServeurSmtp : uses

' Note about Revue
note right of Revue
  Revue extends Document
  but does NOT implement
  Empruntable
  ("est un" != "sait faire")
end note

' Note about composition
note right of Bibliothecaire
  Bibliothecaire HAS-A
  Catalogue (composition)
  not IS-A (inheritance)
end note

' Note about SOLID
note right of RapportService
  SOLID en action:
  - SRP: FormatRapport, Notificateur,
    DestinationRapport séparent les responsabilités
  - OCP: Nouveau format = nouvelle classe
    (ex: FormatJson), sans modifier le service
  - DIP: Injection via constructeur,
    pas de new dans la logique métier
end note

@enduml
